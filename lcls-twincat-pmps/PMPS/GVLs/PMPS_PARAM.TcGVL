<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="PMPS_PARAM" Id="{a73b5237-920e-4906-b8ec-4aaa7f8c0e45}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    MAX_FAST_FAULTS	:	UINT := 50; // Max fast faults for an FFO
    MAX_ASSERTIONS    :    UDINT := 20; //Maximum number of BP requests in the arbiter
    TRANS_MARGIN : REAL := REAL#0.20; // Allowed % margin above requested transmission level in SafeBPCompare (0.2000 = 20deci% default). Note: change this value if scaling factor changes.

    // Attenuator status word bit masks. The attenuator status word is a bit field,
    // the bit layout is documented by ST_AttenuatorStatus.
    ATT_STATUS_AT_TARGET_MASK    :    UINT    :=    16#0001; // Bit 0: attenuator is at its requested transmission
    ATT_STATUS_MOVING_MASK       :    UINT    :=    16#0002; // Bit 1: attenuator is moving
    ATT_STATUS_LOCAL_MODE_MASK   :    UINT    :=    16#0004; // Bit 2: local mode, PMPS requests are ignored
    ATT_STATUS_PMPS_MODE_MASK    :    UINT    :=    16#0008; // Bit 3: PMPS mode, only PMPS setpoints are followed
    ATT_STATUS_OK_MASK           :    UINT    :=    16#0010; // Bit 4: no errors and attenuator is stable
    ATT_STATUS_TOGGLE_MASK       :    UINT    :=    16#0020; // Bit 5: free running toggle
    ATT_STATUS_INCLUDE_MASK      :    UINT    :=    16#0040; // Bit 6: consider this device status
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>