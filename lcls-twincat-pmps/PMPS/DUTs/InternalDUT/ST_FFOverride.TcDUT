<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_FFOverride" Id="{a5b3ae18-23a6-4a51-97e3-c5c85bb95768}">
    <Declaration><![CDATA[TYPE ST_FFOverride :
STRUCT
    {attribute 'pytmc' := '
        pv: Duration
        io: o
     '}
    nDuration : DINT; // DINT to be compatible with EPICS

    {attribute 'pytmc' := '
        pv: Expiration
        io: o
     '}
    nExpiration : DINT; // DINT to be compatible with EPICS

    {attribute 'pytmc' := '
        pv: StartDT
        io: o
     '}
    nStartDT : DINT; // DINT to be compatible with EPICS

    {attribute 'pytmc' := '
        pv: Activate
        io: o
     '}
    bActivate : BOOL;

    {attribute 'pytmc' := '
        pv: Deactivate
        io: o
     '}
    bDeactivate : BOOL;

    {attribute 'pytmc' := '
        pv: ElapsedTime
        io: i
     '}
    nElapsedTime : DINT; // DINT to be compatible with EPICS

    {attribute 'pytmc' := '
        pv: RemainingTime
        io: i
     '}
    nRemainingTime : DINT; // DINT to be compatible with EPICS

    {attribute 'pytmc' := '
        pv: Active
        io: i
     '}
    bActive: BOOL;

    fbTimer    :   TP;
    bOvrdActLogAck : BOOL;
    bOvrdExpLogAck : BOOL;

    rtOvrdActivate : R_TRIG; // Rising edge of bActive, latches the activation log flag
    ftOvrdExpiring : F_TRIG; // Falling edge of bActive, latches the expiry log flag
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>