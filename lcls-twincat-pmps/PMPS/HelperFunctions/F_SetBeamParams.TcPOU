<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_SetBeamParams" Id="{a4b27d6a-ec21-4812-9b64-4caff94fb4ba}" SpecialFunc="None">
    <Declaration><![CDATA[(* Clamps a requested beam parameter set to the PMPS limits and returns it as an ST_BeamParams.

The requested transmission is limited to 0..PMPS_GVL.TRANS_SCALING_FACTOR, the requested
pulse rate to PMPS_GVL.MAX_RATE and the requested beam-class range to
PMPS_GVL.MAX_BC_RANGE. The eV-range bitmask and the auxiliary attenuator states are
passed through unchanged.

The two hardware maxima live only in PMPS_GVL, so the effective limits of a beam
parameter request are auditable in one place and cannot drift away from the full-beam
constant (cstFullBeam), which is built from the same constants.

Usage: called wherever a beam parameter set is assembled for the arbiter, e.g.
FB_BPControlDevice and the FB_SafeBPCompare_Test unit tests.

2026-11-27: the nRate / nBCRange clamps now use PMPS_GVL.MAX_RATE and
PMPS_GVL.MAX_BC_RANGE instead of hard-coded literals (audit finding #260).
*)
FUNCTION F_SetBeamParams : ST_BeamParams
VAR_INPUT
    nTran    :    REAL := 0; // Requested transmission, clamped to 0..PMPS_GVL.TRANS_SCALING_FACTOR
    neVRange    :    DWORD := 0; // Requested photon-energy range bitmask, passed through unchanged
    nRate    :    UDINT := 0; // Requested pulse rate [Hz], clamped to PMPS_GVL.MAX_RATE
    nBCRange : WORD := 0; // Requested beam-class bitmask, clamped to PMPS_GVL.MAX_BC_RANGE
    astAuxAtt : ARRAY [1..PMPS_GVL.AUX_ATTENUATORS] OF ST_PMPS_Attenuator; // Auxiliary attenuator states, passed through unchanged
END_VAR
VAR
    BeamParams    :    ST_BeamParams; // Clamped beam parameter set handed back to the caller

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[BeamParams.nTran := LIMIT(0,nTran,PMPS_GVL.TRANS_SCALING_FACTOR);
BeamParams.astAttenuators := astAuxAtt;
BeamParams.neVRange := neVRange;
BeamParams.nRate    := MIN(nRate,PMPS_GVL.MAX_RATE);
BeamParams.nBCRange	:= MIN(nBCRange,PMPS_GVL.MAX_BC_RANGE);

F_SetBeamParams    := BeamParams;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>