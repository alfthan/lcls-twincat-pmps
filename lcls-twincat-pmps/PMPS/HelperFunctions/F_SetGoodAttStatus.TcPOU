<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_SetGoodAttStatus" Id="{e6cd67bb-2bd9-4b3d-9199-950e5913b39f}" SpecialFunc="None">
    <Declaration><![CDATA[//Use for testing purposes to set the attenuator status to a good state
FUNCTION F_SetGoodAttStatus : UINT
VAR_INPUT
    nStatus : UINT; // Attenuator status word: bit0 AtTarget, bit1 Moving, bit2 LocalMode, bit3 PMPSMode, bit4 OK
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[nStatus.0 := 1;
nStatus.3 := 1;
nStatus.4 := 1;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>