<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_PMPS_JSON" Id="{b8964841-9199-4a13-8d4e-26257c18b849}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Purpose:
        Serialise the PMPS identity of a device or component into a JSON object that is
        attached to a log message, so that every MPS event that needs device context is
        indexed uniformly by the logging back end.
    Usage:
        fbLogMsg.sJson := F_PMPS_JSON(sDevName := StopperName, sPath := sPath, nTypeCode := 1000);
        Produces a JSON object whose keys are, in this fixed order, pmps_typecode
        (unsigned integer), pmps_path (string) and pmps_device_name (string).
        The shared writer PMPS_TOOLS.fbJson is reset before the function returns,
        so consume the result before the next call.
    Objectives:
        - One JSON shape for all PMPS log messages that carry device context.
        - Callers supply only name, path and type code; the wire format lives here only.
    Returns:
        STRING - the serialised JSON object, ready to be assigned to FB_LogMessage.sJson.
    History:
        2020-07-31  Alex Wallace (SLAC)  Initial version - uniform PMPS logging payload.
        2026-11-27  Scirix agent         Documented purpose, usage, return value and the
                                         VAR_INPUT contract (conv_321640e095c0).
*)
FUNCTION F_PMPS_JSON : STRING
VAR_INPUT
    sDevName : STRING := ''; // Device or component name reported in the payload (JSON key
                             // 'pmps_device_name'); free text such as 'SC:DG:ST1' or
                             // '<hostname><device name>', written verbatim - no units.
    sPath    : STRING := ''; // TwinCAT instance path of the reporting FB instance (JSON key
                             // 'pmps_path'), normally its instance-path attribute member,
                             // e.g. 'GVL.fbStopperWatcher' - no units.
    nTypeCode : UINT := 0;   // Event/type code identifying the reported condition (JSON key
                             // 'pmps_typecode'), normally a PMPS_CODES value (e.g. PEW_FAULT =
                             // 16#7, ARB_FULL = 16#201) or 1000 for stopper/veto state changes;
                             // emitted as an unsigned 32-bit number - no units.
END_VAR
VAR

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
PMPS_TOOLS.fbJson.StartObject();
PMPS_TOOLS.fbJson.AddKey('pmps_typecode');
PMPS_TOOLS.fbJson.AddUdint(nTypeCode);
PMPS_TOOLS.fbJson.AddKey('pmps_path');
PMPS_TOOLS.fbJson.AddString(sPath);
PMPS_TOOLS.fbJson.AddKey('pmps_device_name');
PMPS_TOOLS.fbJson.AddString(sDevName);
PMPS_TOOLS.fbJson.EndObject();
F_PMPS_JSON := PMPS_TOOLS.fbJson.GetDocument();
PMPS_TOOLS.fbJson.ResetDocument();]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>