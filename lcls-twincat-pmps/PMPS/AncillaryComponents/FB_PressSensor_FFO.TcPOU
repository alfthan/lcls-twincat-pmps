<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PressSensor_FFO" Id="{09ab3883-be1e-4684-be4b-0a2f4c088ff5}" SpecialFunc="None">
    <Declaration><![CDATA[(* Pressure fast-fault output.

   Trips a fast fault when the measured pressure reaches the EPICS-supplied threshold,
   and releases it once the pressure has fallen a hysteresis band below that threshold.

   Every external value this block consumes - rPress, fFaultThreshold and fHysteresis, all
   written by EPICS - is routed through FB_FallibleRealFromEtherCAT before use: NaN/Inf and
   out-of-span samples are rejected and the last trusted value is held, so a bad link value
   can neither silently disable the pressure trip nor leave it tripped for no reason. The
   per-value validity is exposed on bPressValid / bFaultThresholdValid. If a value stays
   invalid past the sanitizer's qualification time the pressure protection is no longer
   trustworthy, so the block trips instead of quietly losing it.

   Usage:

       fbPressSensor : FB_PressSensor_FFO := (sDevName := 'LINE:PRESS');
       fbPressSensor(io_fbFFHWO := fbFFO);

   History:
       2026-11-27: rPress / fFaultThreshold / fHysteresis sanitized (last-trusted hold,
                   validity flags, validity loss folded into the trip) - audit finding #276.
*)
FUNCTION_BLOCK FB_PressSensor_FFO
VAR_INPUT
    {attribute 'pytmc' := '
        pv: Press
        io: input
        field: EGU Torr
        field: PREC 2
    '}
    rPress : REAL;
    {attribute 'pytmc' := '
        pv: FAULT_SP
        io: input
        field: EGU Torr
        field: PREC 2
    '}
    fFaultThreshold : LREAL; //Faults when the threshold is reached. Trigger value.
    {attribute 'pytmc' := '
        pv: FAULT_SP_HYS
        io: input
        field: EGU %
        field: PREC 2
    '}
    fHysteresis : LREAL :=1; // percentage determining how far below the trigger value the fault should be released
    sDevName: STRING;
    bVeto : BOOL:=FALSE; // This Fault will be will not trip the beam if the bVeto is TRUE
    bAutoReset : BOOL:=TRUE;
END_VAR
VAR_IN_OUT
    io_fbFFHWO    :    FB_HardwareFFOutput;
END_VAR
VAR_OUTPUT
    // rPress was finite and inside the physical pressure span this cycle
    {attribute 'pytmc' := '
        pv: PressValid
        io: i
        field: DESC Pressure input passed sanitization this cycle
    '}
    bPressValid : BOOL;
    // fFaultThreshold was finite and inside the physical pressure span this cycle
    {attribute 'pytmc' := '
        pv: FAULT_SP_VALID
        io: i
        field: DESC Fault threshold input passed sanitization this cycle
    '}
    bFaultThresholdValid : BOOL;
END_VAR
VAR
    {attribute 'instance-path'}
    {attribute 'noinit'}
    sPath: STRING;
    bFAULT_OK:BOOL :=FALSE;
    FFO    :    FB_FastFault :=(
        i_Desc := 'Fault occurs when the pressure trip point is reached',
        i_TypeCode := 16#f700);
    rtRESET	:	R_TRIG;
    ftFAULT	:	F_TRIG;
    fbLogger : FB_LogMessage := (eSubsystem:=E_SubSystem.MPS, nMinTimeViolationAcceptable:=10);

    // Sanitizers for the EPICS-written inputs: reject NaN/Inf and non-physical values and
    // hold the last trusted value while a sample is rejected.
    fbPress : FB_FallibleRealFromEtherCAT;
    fbThreshold : FB_FallibleRealFromEtherCAT;
    fbHysteresis : FB_FallibleRealFromEtherCAT;

    // Last trusted values the trip comparison actually uses
    fPressSanitized : LREAL;
    fThresholdSanitized : LREAL;
    fHysteresisSanitized : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Sanitize every consumed external input first: a rejected sample holds the last trusted
// value, so the trip comparison below can never be silently disabled by a bad link value.
fbPress(
    i_bBridgeOk := TRUE, // these inputs carry no independent EPICS health signal
    i_fValue := rPress,
    i_fMinValue := PMPS_PARAM.MIN_PRESSURE_TORR,
    i_fMaxValue := PMPS_PARAM.MAX_PRESSURE_TORR,
    tInvalidQualifyTime := PMPS_PARAM.T_INPUT_INVALID_TIMEOUT,
    sName := CONCAT(sDevName, ':Press'));

fbThreshold(
    i_bBridgeOk := TRUE,
    i_fValue := LREAL_TO_REAL(fFaultThreshold),
    i_fMinValue := PMPS_PARAM.MIN_PRESSURE_TORR,
    i_fMaxValue := PMPS_PARAM.MAX_PRESSURE_TORR,
    tInvalidQualifyTime := PMPS_PARAM.T_INPUT_INVALID_TIMEOUT,
    sName := CONCAT(sDevName, ':FaultSP'));

// Hysteresis is a percentage, so only NaN/Inf is rejected here: the value is clamped into
// the meaningful 1-100% band below instead of being held at its last trusted value.
fbHysteresis(
    i_bBridgeOk := TRUE,
    i_fValue := LREAL_TO_REAL(fHysteresis),
    tInvalidQualifyTime := PMPS_PARAM.T_INPUT_INVALID_TIMEOUT,
    sName := CONCAT(sDevName, ':FaultSPHys'));

fPressSanitized := REAL_TO_LREAL(fbPress.fValue);
fThresholdSanitized := REAL_TO_LREAL(fbThreshold.fValue);

//Verify Hysteresis is between 1-100, Shouldn't be 0. shouldn't be a 100 either.
fHysteresisSanitized := LIMIT(1, REAL_TO_LREAL(fbHysteresis.fValue), 100);

// Expose the per-value validity of the two values that determine the trip
bPressValid := fbPress.bValid;
bFaultThresholdValid := fbThreshold.bValid;

// Evaluate the threshold trip point. The sanitized values are always finite, so both
// branches below stay reachable; a value that stays invalid past the qualification time
// removes the pressure protection, so that trips rather than quietly holding the trip off.
IF fbPress.bError OR fbThreshold.bError OR fbHysteresis.bError THEN
    bFAULT_OK := FALSE;
ELSIF (fPressSanitized >= fThresholdSanitized) THEN
    bFAULT_OK := FALSE;
ELSIF (fPressSanitized < (fThresholdSanitized - fThresholdSanitized*fHysteresisSanitized/100)) THEN
    bFAULT_OK := TRUE;
END_IF

ACT_Logger();

(*FAST FAULT*)
FFO(i_xOK := bFAULT_OK OR bVeto,
    i_xReset := FALSE,
    i_xAutoReset := bAutoReset,
    i_DevName := sDevName,
    io_fbFFHWO := io_fbFFHWO);
]]></ST>
    </Implementation>
    <Action Name="ACT_Logger" Id="{1d653481-dd30-4081-aa0d-3dbc870b518b}">
      <Implementation>
        <ST><![CDATA[ftFAULT(CLK:= FFO.i_xOK);
rtRESET(CLK:=FFO.i_xOK);

IF(ftFAULT.Q) THEN
    fbLogger(sMsg := 'Pressure Threshold Fault, beam off', eSevr:=TcEventSeverity.Critical);
END_IF

IF(rtRESET.Q) THEN
    fbLogger(sMsg := 'Pressure Threshold Fault condition clear', eSevr:=TcEventSeverity.Info);
END_IF

]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>