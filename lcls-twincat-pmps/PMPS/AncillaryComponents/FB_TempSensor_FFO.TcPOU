<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TempSensor_FFO" Id="{e7283f0f-d3c0-4044-8021-5daf2e8ba234}" SpecialFunc="None">
    <Declaration><![CDATA[(*
Reports a temperature threshold fault, and a failed temperature sensor, as a fast fault.

Objectives:
- Trip the beam (fast fault) when the temperature reaches fFaultThreshold, releasing it only below
  the hysteresis band.
- Read the sensor itself fail-safe / normally closed: the terminal's error, overrange and
  underrange indications are alarm bits, so a single asserted bit, a loss of signal or an
  unpowered/broken sensor (raw value pinned at the terminal end stop) all count as an alarm and
  drop the fast fault. A sensor fault can never leave the beam enabled.

Usage:
- Wire the inherited raw value iRaw, fResolution, bError, bOverrange and bUnderrange from the
  temperature terminal, plus fFaultThreshold/fHysteresis/sDevName, and pass the process-wide
  FB_HardwareFFOutput as io_fbFFHWO. The block publishes TEMP/CONN and owns its FB_FastFault.

History:
2026-11-27 Fail-safe sensor health (audit finding 874): bConnected was NOT (bOverrange AND bError),
           which ignored a single asserted fault bit and any loss of signal. Each error/overrange/
           underrange indication is now inverted into the healthy indication, the raw reading is
           validated against the terminal end stops, and any of them forces the trip.
*)
FUNCTION_BLOCK FB_TempSensor_FFO EXTENDS FB_TempSensor
VAR_INPUT
    {attribute 'pytmc' := '
        pv: FAULT_SP
        io: input
        field: EGU C
        field: PREC 2
    '}
    fFaultThreshold : LREAL; //Faults when the threshold is reached. Trigger value.
    {attribute 'pytmc' := '
        pv: FAULT_SP_HYS
        io: input
        field: EGU %
        field: PREC 2
    '}
    fHysteresis : LREAL :=1; // percentage determining how far below the trigger value the fault should be released
    sDevName: STRING;
    bVeto : BOOL:=FALSE; // This Fault will be will not trip the beam if the bVeto is TRUE
    bAutoReset : BOOL:=TRUE;
END_VAR
VAR_IN_OUT
    io_fbFFHWO    :    FB_HardwareFFOutput;
END_VAR
VAR_OUTPUT
END_VAR
VAR
    {attribute 'instance-path'}
    {attribute 'noinit'}
    sPath: STRING;
    bFAULT_OK:BOOL :=FALSE;
    FFO    :    FB_FastFault :=(
        i_Desc := 'Fault occurs when the temprature trip point is reached',
        i_TypeCode := 16#f700);
    rtRESET	:	R_TRIG;
    ftFAULT	:	F_TRIG;
    ftConnected	:	F_TRIG;
    fbLogger : FB_LogMessage := (eSubsystem:=E_SubSystem.MPS, nMinTimeViolationAcceptable:=10);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// SENSOR HEALTH, read fail-safe (normally closed)
// The manual calls a sensor disconnected when it is overrange *and* in error, but that is not
// fail-safe: a single asserted error or overrange bit stayed "connected" and never tripped the
// beam. The terminal asserts error/overrange/underrange on a fault, so each of those alarm bits is
// inverted into the healthy indication here and ANY one of them alone takes the sensor out of
// service.
fTemp := INT_TO_LREAL(iRaw) * fResolution;
bConnected := NOT bError
          AND NOT bOverrange
          AND NOT bUnderrange;

// Validate the reading itself: an unpowered, open or shorted sensor whose bits both read FALSE
// reports a value pinned at the terminal end stop, so such a reading is a loss of signal and never
// a healthy measurement. (A dead terminal that still holds an in-band value cannot be detected
// from this block alone; the threshold trip remains the last line of defence.)
IF (iRaw = PMPS_PARAM.TEMP_RAW_ENDSTOP_MIN) OR (iRaw = PMPS_PARAM.TEMP_RAW_ENDSTOP_MAX) THEN
    bConnected := FALSE;
END_IF

//Verify Hysteresis is between 1-100, Shouldn't be 0. shouldn't be a 100 either.
fHysteresis:=  LIMIT(1, fHysteresis, 100);

// Evaluate the threshold trip point
IF (fTemp >= fFaultThreshold) THEN
    bFAULT_OK := FALSE;
ELSIF (fTemp < (fFaultThreshold - fFaultThreshold*fHysteresis/100)) THEN
    bFAULT_OK := TRUE;
END_IF
// A sensor that is disconnected, faulted or reading implausibly is an alarm condition: force the
// trip, so a temperature that happens to sit inside the band cannot keep the fast fault released.
IF NOT bConnected THEN
    bFAULT_OK := FALSE;
END_IF


ACT_Logger();

(*FAST FAULT*)
FFO(i_xOK := bFAULT_OK OR bVeto,
    i_xReset :=,
    i_xAutoReset := bAutoReset,
    i_DevName := sDevName,
    io_fbFFHWO := io_fbFFHWO);]]></ST>
    </Implementation>
    <Action Name="ACT_Logger" Id="{2576dc82-55ff-4de9-a3d9-4a950f0ab28a}">
      <Implementation>
        <ST><![CDATA[ftFAULT(CLK:= FFO.i_xOK);
rtRESET(CLK:=FFO.i_xOK);
ftConnected(CLK:= bConnected);

IF(ftConnected.Q) THEN
    fbLogger(sMsg := 'Sensor Fault (error/overrange/underrange or loss of signal), beam off', eSevr:=TcEventSeverity.Critical);
END_IF

IF(ftFAULT.Q) THEN
    fbLogger(sMsg := 'Temp Threshold Fault, beam off', eSevr:=TcEventSeverity.Critical);
END_IF

IF(rtRESET.Q) THEN
    fbLogger(sMsg := 'Temp Threshold Fault condition clear', eSevr:=TcEventSeverity.Info);
END_IF

]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>