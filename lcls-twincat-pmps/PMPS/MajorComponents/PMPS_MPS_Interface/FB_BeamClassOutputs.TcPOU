<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_BeamClassOutputs" Id="{4a29fded-500d-49a8-af9c-1a0c32a74d5a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
FB_BeamClassOutputs - drive the eight hardwired beam class assertion lines.

PURPOSE
    Converts ST_BeamParams.nBeamClass into the hardwired beam class assertion
    lines q_BC_ASSERTION_LINES and mirrors them into the EPICS readback
    epicsBitmap.

USAGE
    Called cyclically (or from a TcUnit suite) wherever all eight beam class
    channels are wired. FB_BeamClassOutputs_BCD is the four-channel variant used
    when the beam class is only driven as a single BCD digit.

OBJECTIVES
    - Sizes q_BC_ASSERTION_LINES and bounds the per-scan loops with
      PMPS_PARAM.MAX_BEAM_CLASS_LINES, so the line count is declared once in a
      global variable list and can be reused or changed in a single place.
    - Derives the full-beam line (the last channel) from the same constant
      instead of the literal 8, so the index cannot fall off the array if the
      line count changes.

HISTORY
    2026-11-28 / Scirix Agent
        Moved MAX_BEAM_CLASS_LINES out of this POU's VAR CONSTANT into
        PMPS_PARAM and replaced the hard-coded line indices 1..8 with a loop
        bounded by that constant (audit finding #1143, convention
        conv_a8288970c008 - same pattern as FB_BeamClassOutputs_BCD).
*)
{attribute 'no_check'}
FUNCTION_BLOCK FB_BeamClassOutputs
VAR_INPUT
    BP : ST_BeamParams;
END_VAR
VAR_OUTPUT
END_VAR
VAR
    nBeamClass   :    BYTE;
    wBeamClass    :    BYTE;

    InitCounter: BYTE;
    counter    :    INT;

    // Beam class lines are restricted to PMPS_PARAM.MAX_BEAM_CLASS_LINES
    // channels in the current design, since there are no plans to use all 16.
    // Channels 1-7 may be allocated to any other beam classes so long as they
    // are ordered least to greatest. The last channel is reserved for full beam.
    {attribute 'pytmc' := 'pv: BeamClassChannel
        io: i
        field: DESC Hardwire channel state'}
        epicsBitmap : WORD;

    // TcLinkTo indices must be literals, so keep them in step with
    // PMPS_PARAM.MAX_BEAM_CLASS_LINES if the line count ever changes.
    {attribute 'TcLinkTo' := '[1] := TIIB[PMPS_Premp]^Channel 1^Output;
                              [2] := TIIB[PMPS_Premp]^Channel 2^Output;
                              [3] := TIIB[PMPS_Premp]^Channel 3^Output;
                              [4] := TIIB[PMPS_Premp]^Channel 4^Output;

                              [5] := TIIB[PMPS_Premp]^Channel 5^Output;
                              [6] := TIIB[PMPS_Premp]^Channel 6^Output;
                              [7] := TIIB[PMPS_Premp]^Channel 7^Output;
                              [8] := TIIB[PMPS_Premp]^Channel 8^Output;'} // 8 - Full beam
    q_BC_ASSERTION_LINES    AT    %Q*    : ARRAY [1..PMPS_PARAM.MAX_BEAM_CLASS_LINES] OF    BOOL;
END_VAR
VAR CONSTANT
    BC_1HZ : BYTE := 1;
    BC_10HZ : BYTE := 2;
    BC_FULL : BYTE := 16;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Determine BC
IF BP.nRate >= 120 THEN
    nBeamClass := BC_FULL;
ELSIF BP.nRate >= 10 THEN
    nBeamClass := BC_10HZ;
ELSIF BP.nRate >= 1 THEN
    nBeamClass := BC_1HZ;
ELSE
    nBeamClass := 0;
END_IF


//Assert Beam Class
////////////////////////////////////
//0x0 = 0000 0000 0000 0000
//0x1 = 0000 0000 0000 0001
//0xF = 1111 1111 1111 1111

//Initialize BC lines to zero on every pass
FOR InitCounter := 1 TO PMPS_PARAM.MAX_BEAM_CLASS_LINES DO
    q_BC_ASSERTION_LINES[InitCounter] := FALSE;
END_FOR

//Set BC lines according to beam class
//A BC of 0x0 would pass over this loop, setting none of the lines high
// , as FOR loops check the initialized variable at the top to see if it's >
// than the "TO" variable.
FOR wBeamClass:=1 TO MIN(PMPS_PARAM.MAX_BEAM_CLASS_LINES - 1, nBeamClass) DO
    q_BC_ASSERTION_LINES[wBeamClass] := TRUE;
END_FOR

q_BC_ASSERTION_LINES[PMPS_PARAM.MAX_BEAM_CLASS_LINES] := nBeamClass = BC_FULL; //Set the last channel true if BC is full beam

// Readbacks for EPICS: same bit position as the hardwired channel
epicsBitmap := 0; // Rebuilt from the lines below
FOR InitCounter := 1 TO PMPS_PARAM.MAX_BEAM_CLASS_LINES DO
    IF q_BC_ASSERTION_LINES[InitCounter] THEN
        epicsBitmap := epicsBitmap OR SHL(WORD#1, InitCounter - 1);
    END_IF
END_FOR
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>