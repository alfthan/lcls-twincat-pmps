<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_BeamClassOutputs_BCD" Id="{dbf80532-276b-48e1-be9a-f6bd5bc2e3ab}" SpecialFunc="None">
    <Declaration><![CDATA[(*
FB_BeamClassOutputs_BCD - drive the beam class assertion lines as a BCD digit.

PURPOSE
    Converts ST_BeamParams.nBeamClass into the hardwired beam class assertion
    lines q_BC_ASSERTION_LINES and mirrors them into the EPICS readback
    epicsBitmap.

USAGE
    Called cyclically (or from a TcUnit suite) wherever the PMPS has only the
    four hardwired beam class channels, i.e. a single BCD digit. Use
    FB_BeamClassOutputs when all eight channels are wired.

OBJECTIVES
    - Sizes q_BC_ASSERTION_LINES and bounds the per-scan bit-mapping loop with
      PMPS_PARAM.MAX_BEAM_CLASS_BCD_LINES, so the line count is declared once in
      a global variable list and can be reused or changed in a single place.
    - Writes every line on every pass, so no line is left uninitialised and no
      index can run past the end of q_BC_ASSERTION_LINES.

HISTORY
    2026-11-28 / Scirix Agent
        Moved MAX_BEAM_CLASS_LINES out of this POU's VAR CONSTANT into
        PMPS_PARAM and replaced the hard-coded line indices 1..4 with a loop
        bounded by that constant, so the array declaration, the line assignment
        and the EPICS readback share one source of truth
        (audit finding #1143, convention conv_a8288970c008).
*)
{attribute 'no_check'}
FUNCTION_BLOCK FB_BeamClassOutputs_BCD
VAR_INPUT
    BP : ST_BeamParams;
END_VAR
VAR_OUTPUT
END_VAR
VAR
    nBeamClass   :    BYTE;
    wBeamClass    :    BYTE;

    InitCounter: BYTE;
    counter    :    INT;

    // Beam class lines are restricted to PMPS_PARAM.MAX_BEAM_CLASS_BCD_LINES
    // channels in the current design (a single BCD digit).
    // There are 16 possible beamclasses with 0 -15 with 0 no beam.
    // Line 1 carries the LSB and the last line carries the MSB.
    {attribute 'pytmc' := 'pv: BeamClassChannel
        io: i
        field: DESC Hardwire channel state'}
        epicsBitmap : WORD;

    // TcLinkTo indices must be literals, so keep them in step with
    // PMPS_PARAM.MAX_BEAM_CLASS_BCD_LINES if the line count ever changes.
    {attribute 'TcLinkTo' := '[1] := TIIB[PMPS_Premp]^Channel 1^Output;
                              [2] := TIIB[PMPS_Premp]^Channel 2^Output;
                              [3] := TIIB[PMPS_Premp]^Channel 3^Output;
                              [4] := TIIB[PMPS_Premp]^Channel 4^Output;'}
    q_BC_ASSERTION_LINES    AT    %Q*    : ARRAY [1..PMPS_PARAM.MAX_BEAM_CLASS_BCD_LINES] OF    BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
//Set BC lines according to beam class
// There are PMPS_PARAM.MAX_BEAM_CLASS_BCD_LINES digital outputs, so the BC is
// asserted as a BCD digit: line 1 carries beam class bit 0 (LSB) and the last
// line carries the MSB. The loop is bounded by the same named constant as the
// array declaration, so every line is written on every pass (none is left
// uninitialised) and no index can run past the end of q_BC_ASSERTION_LINES.
epicsBitmap := 0; // EPICS readback, rebuilt from the lines below

FOR InitCounter := 1 TO PMPS_PARAM.MAX_BEAM_CLASS_BCD_LINES DO
    q_BC_ASSERTION_LINES[InitCounter] := (BP.nBeamClass AND SHL(BYTE#1, InitCounter - 1)) <> 0;

    // Readback for EPICS: same bit position as the hardwired channel
    IF q_BC_ASSERTION_LINES[InitCounter] THEN
        epicsBitmap := epicsBitmap OR SHL(WORD#1, InitCounter - 1);
    END_IF
END_FOR
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>