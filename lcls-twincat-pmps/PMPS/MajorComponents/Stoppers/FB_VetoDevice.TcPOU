<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_VetoDevice" Id="{23cb2824-120c-479d-8abf-179942f9afb5}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_VetoDevice
// Relays veto device state, updates current BP and sends a message when veto state changes.
// VetoDevice_IN / VetoDevice_OUT name the aVetoDevices slots this instance drives. They are
// untrusted configuration: an index outside ARRAY [1..PMPS_GVL.MAX_VETO_DEVICES] (0 = not
// configured) leaves the beam parameters untouched and is reported once through the logger.
// stCurrentBP is a caller-supplied VAR_IN_OUT and is validated with __ISVALIDREF first.
FUNCTION_BLOCK FB_VetoDevice
VAR_INPUT
    i_bIn : BOOL;
    i_bOut : BOOL;
END_VAR
VAR_OUTPUT
    q_bIn : BOOL;
    q_bOut : BOOL;
END_VAR
VAR_IN_OUT
    stCurrentBP : ST_BeamParams; // Beam parameter set to update: must be a valid reference
END_VAR
VAR

    VetoDevice_IN : UINT := 0; // aVetoDevices index for the IN state (valid 1..PMPS_GVL.MAX_VETO_DEVICES, 0 = not configured)
    VetoDevice_OUT : UINT := 0; // aVetoDevices index for the OUT state (valid 1..PMPS_GVL.MAX_VETO_DEVICES, 0 = not configured)

    VetoDeviceName : STRING;
    {attribute 'instance-path'}
    {attribute 'noinit'}
    sPath    :    T_MaxString;

    // Logging
        fbLogMsg : FB_LogMessage := (
            eSubSystem := E_Subsystem.MPS);

        rtIn : R_TRIG;
        rtOut : R_TRIG;
    ////////////////////////////////

    bInit: BOOL := TRUE;

    // Guards for caller-supplied data (latched so each diagnostic is logged once)
    bRefInvalidWarned : BOOL; // TRUE once the invalid stCurrentBP reference has been reported
    bInIndexInvalidWarned : BOOL; // TRUE once a bad VetoDevice_IN index has been reported
    bOutIndexInvalidWarned : BOOL; // TRUE once a bad VetoDevice_OUT index has been reported
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bInit THEN
    fbLogMsg.sJson := F_PMPS_JSON(VetoDeviceName, sPath, 1000);
    bInit := FALSE;
END_IF

// Log
/////////////////////////////
    rtIn(CLK := i_bIn);
    rtOut(CLK := i_bOut);

    IF rtIn.Q THEN
        fbLogMsg.sMsg := CONCAT(VetoDeviceName, ' moved IN');
        fbLogMsg();
    ELSIF rtOut.Q THEN
        fbLogMsg.sMsg := CONCAT(VetoDeviceName, ' moved OUT');
        fbLogMsg();
    END_IF

// Relay
///////////////////////
    q_bIn := i_bIn;
    q_bOut := i_bOut;

// Update current beam parameters
/////////////////////////////////////
// stCurrentBP is supplied by the caller, so validate the reference before any
// dereference: an unbound VAR_IN_OUT reference faults the PLC.
IF __ISVALIDREF(stCurrentBP) THEN

    // aVetoDevices is ARRAY [1..PMPS_GVL.MAX_VETO_DEVICES]; bounds-check each configured
    // index before indexing so a bad configuration cannot write outside the array.
    IF (VetoDevice_IN >= 1) AND (VetoDevice_IN <= PMPS_GVL.MAX_VETO_DEVICES) THEN
        stCurrentBP.aVetoDevices[VetoDevice_IN] := i_bIn;
    ELSIF NOT bInIndexInvalidWarned THEN
        fbLogMsg.sMsg := CONCAT(VetoDeviceName, ': veto IN index not configured or out of range, BP not updated');
        fbLogMsg();
        bInIndexInvalidWarned := TRUE;
    END_IF

    IF (VetoDevice_OUT >= 1) AND (VetoDevice_OUT <= PMPS_GVL.MAX_VETO_DEVICES) THEN
        stCurrentBP.aVetoDevices[VetoDevice_OUT] := i_bOut;
    ELSIF NOT bOutIndexInvalidWarned THEN
        fbLogMsg.sMsg := CONCAT(VetoDeviceName, ': veto OUT index not configured or out of range, BP not updated');
        fbLogMsg();
        bOutIndexInvalidWarned := TRUE;
    END_IF

ELSE
    // Invalid reference: skip the update rather than fault the PLC.
    IF NOT bRefInvalidWarned THEN
        fbLogMsg.sMsg := CONCAT(VetoDeviceName, ': stCurrentBP reference invalid, BP not updated');
        fbLogMsg();
        bRefInvalidWarned := TRUE;
    END_IF
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>