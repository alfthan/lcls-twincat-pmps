<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FallibleRealFromEtherCAT" Id="{bf246e22-6c68-455f-b3e3-17c95da6a5c3}" SpecialFunc="None">
    <Declaration><![CDATA[
(* Sanitizes one REAL read across the arbiter bridge (the native wire type for bridge PDOs). The caller
   links the raw PDO value and derives bridge health elsewhere (e.g. FB_SubSysToArbiter_IO.bBridgeOk)
   and passes both in each cycle; this FB owns no hardware links. It holds the last trusted value while
   the input reads NaN/Inf or the bridge is down. Error reports only the locally-detected sustained
   non-finite condition; fault on bad comms via the bridge FB's bBridgeConfirmedBad in the caller.
   Value widens to LREAL for I_FallibleLreal consumers.

   The manual override of the sanitized value (bOverride) is permission-qualified and
   self-clearing: it is honoured only after the bridge has been healthy for
   PMPS_PARAM.OVRD_QUALIFICATION_TIME, it holds only while the bridge stays healthy, and
   it clears itself after PMPS_PARAM.OVRD_MAX_DURATION. An override substitutes the
   value only - bError always reports the sanitizer's own fault state, so an override
   can never hide an invalid input.

   2026-11-27 Scirix Agent: replaced the unqualified bOverride/bypass with a qualified,
   self-clearing override and made bError independent of it.
   *)
FUNCTION_BLOCK FB_FallibleRealFromEtherCAT
IMPLEMENTS I_FallibleLreal
VAR_INPUT
    i_bBridgeOk : BOOL;
    i_fValue : REAL;
    sName : STRING := 'FallibleReal';
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: Value
        io: i
    '}
    fValue : REAL;
    {attribute 'pytmc' := '
        pv: InputNotFinite
        io: i
    '}
    bInputNotFinite : BOOL;

    {attribute 'pytmc' := '
        pv: Error
        io: i
    '}
    bError : BOOL;
END_VAR
VAR
    tHeartbeatExpirationTime : TIME;
    fLastValidValue : REAL;
    tonNonFiniteInputTimeout : TON;
    rtNonFiniteConfirmed : R_TRIG;
    fbLog : FB_LogMessage := (
        eSevr := TcEventSeverity.Error,
        eSubsystem := E_Subsystem.MPS
    );

    // Manual override of the sanitized value. Nothing requests it today; when a caller
    // does, it is honoured only once the bridge has been healthy for the qualification
    // time, holds only while the bridge stays healthy, and clears itself after the
    // maximum duration.
    bOverride : BOOL; // Override request
    fOverrideValue : REAL; // Value substituted while the override is in force
    tonOverrideQualify : TON; // Qualifies the permission before the override is honoured
    tonOverrideDuration : TON; // Maximum override duration; on expiry the override clears
    ftOverrideRequest : F_TRIG; // Releasing the request re-arms it for a fresh override
    xOverrideActive : BOOL; // Override is in force this cycle
    xOverrideExpired : BOOL; // Latched when the maximum duration cleared the override
    rtOverrideActive : R_TRIG; // Logs the override becoming active
    ftOverrideActive : F_TRIG; // Logs the override being released
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
bInputNotFinite := NOT IsFinite(x := F_REAL(in := i_fValue));
tonNonFiniteInputTimeout(IN := bInputNotFinite, PT := tHeartbeatExpirationTime);

IF i_bBridgeOk AND NOT bInputNotFinite THEN
    fLastValidValue := i_fValue;
END_IF

// Manual override (see the declaration for the contract): permission-qualified,
// self-clearing after a maximum duration, and dropped as soon as the permission goes.
tonOverrideQualify(IN := bOverride AND i_bBridgeOk, PT := PMPS_PARAM.OVRD_QUALIFICATION_TIME);

IF tonOverrideQualify.Q AND NOT xOverrideExpired THEN
    xOverrideActive := TRUE;
END_IF

// The override clears itself after the maximum duration and stays cleared until the
// request is released and issued again, so holding the request cannot keep it on.
tonOverrideDuration(IN := xOverrideActive, PT := PMPS_PARAM.OVRD_MAX_DURATION);
IF tonOverrideDuration.Q THEN
    xOverrideActive := FALSE;
    xOverrideExpired := TRUE;
END_IF

// A released request or a lost bridge link ends the override immediately.
ftOverrideRequest(CLK := bOverride);
IF NOT bOverride OR NOT i_bBridgeOk THEN
    xOverrideActive := FALSE;
END_IF
IF ftOverrideRequest.Q THEN
    xOverrideExpired := FALSE;
END_IF

// Log the override transitions, not every cycle they are held.
rtOverrideActive(CLK := xOverrideActive);
IF rtOverrideActive.Q THEN
    fbLog(sMsg := CONCAT(sName, ': manual override active'), eSevr := TcEventSeverity.Warning);
END_IF

ftOverrideActive(CLK := xOverrideActive);
IF ftOverrideActive.Q THEN
    fbLog(sMsg := CONCAT(sName, ': manual override released'), eSevr := TcEventSeverity.Warning);
END_IF

fValue := SEL(xOverrideActive, SEL(bInputNotFinite OR NOT i_bBridgeOk, i_fValue, fLastValidValue), fOverrideValue);

rtNonFiniteConfirmed(CLK := tonNonFiniteInputTimeout.Q);
IF rtNonFiniteConfirmed.Q THEN
    fbLog(sMsg := CONCAT(sName, ': input value not finite (NaN/Inf) for longer than timeout'));
END_IF

// The fault state is the sanitizer's own: an override substitutes the value and never
// masks the locally detected non-finite condition.
bError := tonNonFiniteInputTimeout.Q;]]></ST>
    </Implementation>
    <Property Name="Error" Id="{923f5a6d-36ca-4c5b-a726-b6b176323b9c}">
      <Declaration><![CDATA[PROPERTY Error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{830ab532-f9a0-4b67-8fa2-e3cbad57ab6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[
Error :=  bError;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{a80c7b01-cf7d-4537-9701-50bbcf70fbc7}">
      <Declaration><![CDATA[
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)

    tHeartbeatExpirationTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
THIS^.tHeartbeatExpirationTime := tHeartbeatExpirationTime;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Value" Id="{ac107dc6-e7bd-47e5-9026-99d3152f9d3e}">
      <Declaration><![CDATA[
PROPERTY Value : LREAL
]]></Declaration>
      <Get Name="Get" Id="{3a649150-cb5c-49d5-a02e-b3f67e06554b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[
Value := REAL_TO_LREAL(THIS^.fValue);
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>