<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FallibleRealFromEtherCAT" Id="{bf246e22-6c68-455f-b3e3-17c95da6a5c3}" SpecialFunc="None">
    <Declaration><![CDATA[
(* Sanitizes one REAL taken from an external, untrusted source: a bridge PDO read across
   the arbiter EL669x link, or an EPICS-written input. The caller passes the raw value and,
   where one exists, that source's health flag each cycle; this FB owns no hardware links.

   A sample is only trusted when it is finite (not NaN/Inf), inside the caller's physical
   span (i_fMinValue / i_fMaxValue) and the source reports healthy (i_bBridgeOk - pass TRUE
   when the caller has no independent health signal). While samples are rejected the last
   trusted value is held on fValue, so a consumer never sees NaN/Inf or a value outside the
   span. bValid says whether this cycle's sample was trusted, bInputNotFinite / bOutOfRange
   say why it was not, and bError reports a sustained rejection (invalid for longer than
   tInvalidQualifyTime) - that is the flag a caller folds into its fault logic. A single bad
   sample only holds the last trusted value.

   Usage:

       fbPress : FB_FallibleRealFromEtherCAT;
       ...
       fbPress(i_bBridgeOk := TRUE,
               i_fValue    := rPress,
               i_fMinValue := PMPS_PARAM.MIN_PRESSURE_TORR,
               i_fMaxValue := PMPS_PARAM.MAX_PRESSURE_TORR);

   History:
       2026-11-27: physical-span rejection, bValid/bOutOfRange outputs and a working bError;
                   the qualification time is a normal input instead of an FB_Init parameter.
*)
FUNCTION_BLOCK FB_FallibleRealFromEtherCAT
IMPLEMENTS I_FallibleLreal
VAR_INPUT
    // TRUE while the source is healthy (bridge up and data live); TRUE when no separate health signal exists
    i_bBridgeOk : BOOL;
    // raw value as read from the external source
    i_fValue : REAL;
    // physical span; a finite sample outside it is rejected. Defaults to the full REAL span (no range check)
    i_fMinValue : REAL := REAL#-3.4028235E38;
    i_fMaxValue : REAL := REAL#3.4028235E38;
    // how long a sample may stay invalid before bError is raised
    tInvalidQualifyTime : TIME := T#5S;
    sName : STRING := 'FallibleReal';
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: Value
        io: i
    '}
    fValue : REAL;
    {attribute 'pytmc' := '
        pv: InputNotFinite
        io: i
    '}
    bInputNotFinite : BOOL;
    {attribute 'pytmc' := '
        pv: InputOutOfRange
        io: i
    '}
    bOutOfRange : BOOL;
    {attribute 'pytmc' := '
        pv: Valid
        io: i
    '}
    bValid : BOOL;

    {attribute 'pytmc' := '
        pv: Error
        io: i
    '}
    bError : BOOL;
END_VAR
VAR
    fLastValidValue : REAL;
    tonInputInvalidTimeout : TON;
    rtInputInvalidConfirmed : R_TRIG;
    fbLog : FB_LogMessage := (
        eSevr := TcEventSeverity.Error,
        eSubsystem := E_Subsystem.MPS
    );

    bInputRejected : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Reject anything that is not a trustworthy sample: non-finite, outside the caller's
// physical span, or read while the source is unhealthy.
bInputNotFinite := NOT IsFinite(x := F_REAL(in := i_fValue));
bOutOfRange := NOT bInputNotFinite AND ((i_fValue < i_fMinValue) OR (i_fValue > i_fMaxValue));
bInputRejected := bInputNotFinite OR bOutOfRange OR NOT i_bBridgeOk;
bValid := NOT bInputRejected;

// Only a trusted sample updates the held value; everything else keeps the last one.
IF bValid THEN
    fLastValidValue := i_fValue;
END_IF

fValue := SEL(bInputRejected, i_fValue, fLastValidValue);

// A single bad sample only holds the last trusted value; a sustained one is reported.
tonInputInvalidTimeout(IN := bInputNotFinite OR bOutOfRange, PT := tInvalidQualifyTime);
rtInputInvalidConfirmed(CLK := tonInputInvalidTimeout.Q);
IF rtInputInvalidConfirmed.Q THEN
    fbLog(sMsg := CONCAT(sName, ': input value not finite or out of range for longer than timeout'));
END_IF

bError := tonInputInvalidTimeout.Q;
]]></ST>
    </Implementation>
    <Property Name="Error" Id="{923f5a6d-36ca-4c5b-a726-b6b176323b9c}">
      <Declaration><![CDATA[PROPERTY Error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{830ab532-f9a0-4b67-8fa2-e3cbad57ab6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[
Error :=  bError;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Value" Id="{ac107dc6-e7bd-47e5-9026-99d3152f9d3e}">
      <Declaration><![CDATA[
PROPERTY Value : LREAL
]]></Declaration>
      <Get Name="Get" Id="{3a649150-cb5c-49d5-a02e-b3f67e06554b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[
Value := REAL_TO_LREAL(THIS^.fValue);
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>